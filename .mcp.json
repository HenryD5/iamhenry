{
  "mcpServers": {
    "chrome": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222",
        "--categoryMemory=false",
        "--categoryPerformance=false",
        "--screenshotFormat=jpeg",
        "--screenshotMaxWidth=1024",
        "--no-usage-statistics"
      ]
    }
  }
}
