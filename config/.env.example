# Variables publicas del frontend (example). No son secretas: no pongas secretos aqui.
# NEXT_PUBLIC_SITE_URL es un marcador hasta definir el dominio.
NEXT_PUBLIC_SITE_URL=https://iamhenry.example.com
NEXT_PUBLIC_APP_NAME=IamHenry
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_GTM_ID=

# Los valores de Sanity van en .env.local y en el panel de Vercel.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=

# Contacto (opcionales en build). Secretos solo en .env.local y en el panel de Vercel.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
